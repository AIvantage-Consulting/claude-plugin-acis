{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACIS Challenge Result",
  "description": "Output from a challenger agent evaluating a goal's merit",
  "type": "object",
  "required": ["goal_id", "challenger", "verdict", "reasoning"],
  "properties": {
    "goal_id": {
      "type": "string",
      "description": "ID of the goal being challenged"
    },
    "challenger": {
      "type": "string",
      "enum": ["technical", "strategic"]
    },
    "verdict": {
      "type": "string",
      "enum": ["accept", "downgrade", "low_roi", "reject"],
      "description": "Challenger's verdict on this goal"
    },
    "reasoning": {
      "type": "string",
      "minLength": 20,
      "description": "Justification for the verdict"
    },
    "suggested_severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"],
      "description": "For DOWNGRADE verdicts: what the severity should be"
    },
    "roi_analysis": {
      "type": "object",
      "description": "For LOW-ROI verdicts: cost-benefit breakdown (strategic challenger only)",
      "properties": {
        "estimated_effort": {
          "type": "string",
          "enum": ["trivial", "small", "medium", "large"]
        },
        "estimated_impact": {
          "type": "string",
          "enum": ["none", "minimal", "moderate", "significant", "critical"]
        },
        "tech_debt_factor": {
          "type": "string",
          "description": "How this relates to technical debt"
        },
        "recommendation": {
          "type": "string",
          "description": "What the user should consider"
        }
      }
    },
    "dimensions": {
      "type": "object",
      "description": "Per-dimension assessment. Each challenger populates ONLY its own dimensions; others are omitted.",
      "properties": {
        "factual_accuracy": {
          "type": "object",
          "description": "Technical challenger only",
          "properties": {
            "passed": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "codebase_awareness": {
          "type": "object",
          "description": "Technical challenger only",
          "properties": {
            "passed": { "type": "boolean" },
            "notes": { "type": "string" },
            "is_intentional": { "type": "boolean" }
          }
        },
        "contradictions": {
          "type": "object",
          "description": "Technical challenger only",
          "properties": {
            "found": { "type": "boolean" },
            "conflicting_goal_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "notes": { "type": "string" }
          }
        },
        "architecture_alignment": {
          "type": "object",
          "description": "Technical challenger only",
          "properties": {
            "aligned": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "cost_benefit": {
          "type": "object",
          "description": "Strategic challenger only",
          "properties": {
            "roi_rating": {
              "type": "string",
              "enum": ["high", "medium", "low", "negligible"]
            },
            "notes": { "type": "string" }
          }
        },
        "persona_impact": {
          "type": "object",
          "description": "Strategic challenger only",
          "properties": {
            "impacts_target_users": { "type": "boolean" },
            "affected_personas": {
              "type": "array",
              "items": { "type": "string" }
            },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "investigation_depth": {
      "type": "string",
      "enum": ["light", "deep"],
      "description": "What level of investigation was performed"
    },
    "evidence": {
      "type": "array",
      "description": "Files read, commands run, or other evidence gathered",
      "items": {
        "type": "string"
      }
    }
  }
}
