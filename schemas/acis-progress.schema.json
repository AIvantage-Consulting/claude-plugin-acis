{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACIS Progress",
  "description": "Per-goal iteration history for fresh-agent continuation (.acis/progress/{goal-id}.json)",
  "type": "object",
  "required": [
    "goalId",
    "iterations",
    "currentMeasurement",
    "iterationEpisodes",
    "architecturalConstraints",
    "complexityEvidence"
  ],
  "properties": {
    "goalId": {
      "type": "string",
      "description": "Goal ID this progress tracks"
    },
    "goalFile": {
      "type": "string",
      "description": "Path to the goal JSON file"
    },
    "discoveryFile": {
      "type": "string",
      "description": "Path to the DISCOVERY.md for this goal"
    },
    "iterations": {
      "type": "array",
      "description": "History of fix iterations (read by fresh agents)",
      "items": {
        "type": "object",
        "required": [
          "number",
          "agentType",
          "action",
          "result",
          "contextUsed"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "agentType": {
            "type": "string",
            "description": "Agent that performed this iteration"
          },
          "action": {
            "type": "string",
            "description": "What the agent did"
          },
          "filesModified": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "type": "string",
            "enum": [
              "success",
              "partial",
              "blocked",
              "failed"
            ]
          },
          "commit": {
            "type": "string",
            "description": "Git commit hash if changes were committed"
          },
          "contextUsed": {
            "type": "number",
            "description": "Percentage of context used (0-100)"
          },
          "notes": {
            "type": "string",
            "description": "Additional context for next iteration"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "currentMeasurement": {
      "type": "object",
      "description": "Latest measurement from detection command",
      "required": [
        "command",
        "currentValue",
        "targetValue",
        "status"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "currentValue": {
          "type": [
            "string",
            "number"
          ]
        },
        "targetValue": {
          "type": [
            "string",
            "number"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "achieved",
            "not-achieved",
            "error",
            "pending"
          ]
        },
        "measuredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "fiveWhysAnalyses": {
      "type": "array",
      "description": "5 Whys analyses performed during iterations",
      "items": {
        "type": "object",
        "required": [
          "iteration",
          "problem",
          "rootCause"
        ],
        "properties": {
          "iteration": {
            "type": "integer"
          },
          "problem": {
            "type": "string"
          },
          "why1": {
            "type": "string"
          },
          "why2": {
            "type": "string"
          },
          "why3": {
            "type": "string"
          },
          "why4": {
            "type": "string"
          },
          "why5": {
            "type": "string"
          },
          "rootCause": {
            "type": "string"
          },
          "fixPlan": {
            "type": "string"
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "description": "Checkpoints where human input was required",
      "items": {
        "type": "object",
        "required": [
          "iteration",
          "type",
          "question"
        ],
        "properties": {
          "iteration": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "decision",
              "verification",
              "blocked"
            ]
          },
          "question": {
            "type": "string"
          },
          "userResponse": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "iterationEpisodes": {
      "type": "array",
      "description": "Compressed episodic memory per RALPH iteration (mirrors goal.progress.iteration_episodes)",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "episodeId",
          "iteration",
          "approach",
          "outcome",
          "timestamp"
        ],
        "properties": {
          "episodeId": {
            "type": "string",
            "pattern": "^ep-[0-9]{3}$"
          },
          "iteration": {
            "type": "integer",
            "minimum": 1
          },
          "approach": {
            "type": "string",
            "minLength": 10
          },
          "filesModified": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outcome": {
            "type": "string",
            "enum": [
              "success",
              "partial_success",
              "failure",
              "blocked",
              "regression"
            ]
          },
          "metricDelta": {
            "type": "object",
            "properties": {
              "before": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "after": {
                "type": [
                  "number",
                  "string"
                ]
              }
            }
          },
          "functionalResults": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "constraintsDiscovered": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nextRecommendation": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "architecturalConstraints": {
      "type": "array",
      "description": "Formalized constraints with lifecycle (mirrors goal.progress.architectural_constraints)",
      "items": {
        "type": "object",
        "required": [
          "constraintId",
          "discoveredAtIteration",
          "source",
          "description",
          "status"
        ],
        "properties": {
          "constraintId": {
            "type": "string",
            "pattern": "^ac-[0-9]{3}$"
          },
          "discoveredAtIteration": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "enum": [
              "functional_failure",
              "verification_failure",
              "agent_discovery",
              "user_input",
              "five_whys"
            ]
          },
          "description": {
            "type": "string"
          },
          "affectedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mustDo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mustNot": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "superseded",
              "invalidated"
            ]
          },
          "supersededBy": {
            "type": "string",
            "pattern": "^ac-[0-9]{3}$"
          }
        }
      }
    },
    "complexityEvidence": {
      "type": "array",
      "description": "Runtime evidence for complexity escalation (mirrors goal.progress.complexity_evidence)",
      "items": {
        "type": "object",
        "required": [
          "evidenceId",
          "iteration",
          "type",
          "details",
          "recommendation"
        ],
        "properties": {
          "evidenceId": {
            "type": "string",
            "pattern": "^ce-[0-9]{3}$"
          },
          "iteration": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "type": "string",
            "enum": [
              "file_count_exceeded",
              "detection_command_count",
              "scope_creep",
              "regression_pattern",
              "stuck_pattern"
            ]
          },
          "details": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "properties": {
              "threshold": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "actual": {
                "type": [
                  "number",
                  "string"
                ]
              }
            }
          },
          "recommendation": {
            "type": "string",
            "enum": [
              "decompose",
              "escalate_tier",
              "user_review",
              "continue"
            ]
          },
          "originalTier": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ]
          },
          "recommendedTier": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ]
          },
          "userDecision": {
            "type": "string",
            "enum": [
              "accepted",
              "rejected",
              "deferred"
            ]
          }
        }
      }
    }
  }
}
